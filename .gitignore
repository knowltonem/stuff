# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Word lock files
~$*

# Python
__pycache__/
*.py[cod]
*.pyo

# Secrets / credentials (guard against accidental commit)
.env
.env.*
*.pem
*.key
*.secret

# Runbook auto-generated files
_Runbook/.runbook_state.json
_Runbook/Backup/
_Runbook/*.log
